# Vercel Environment Variables - Instahub

NODE_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL Database (Transaction Pooler Connection String is recommended for Vercel Serverless)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?pgbouncer=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/instahub

# Supabase Application Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection Pool Limits (For Vercel Serverless environment, lower max pool is recommended)
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=10000

# Internal Security (Random, secure string for encrypting the admin session cookies and social job tokens)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SEARCH_JOB_SECRET=super_secret_search_job_signing_key_for_production

# Fulfillment Integrations
PEAKERR_API_KEY=
PEAKERR_LIVE_FULFILLMENT=false
PEAKERR_AUTO_DISPATCH_ENABLED=false
PEAKERR_STATUS_SYNC_ENABLED=false

# Social Lookups
HIKER_API_KEY=
BRIGHTDATA_API_KEY=

# Bright Data Social Scraper Datasets
BRIGHTDATA_TIKTOK_DATASET=
BRIGHTDATA_TIKTOK_POST_DATASET=
BRIGHTDATA_TWITTER_DATASET=
BRIGHTDATA_TWITTER_POST_DATASET=
BRIGHTDATA_YOUTUBE_DATASET=
BRIGHTDATA_YOUTUBE_VIDEO_DATASET=

# Payments
CENTERPAG_WEBHOOK_TOKEN=

# Emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Base Config
API_TIMEOUT=10000
FULFILLMENT_PROVIDER=manual
PAYMENT_PROVIDER=centerpag
EMAIL_PROVIDER=resend
